# ---- Ootybites backend env ----
# Copy to .env and fill in. Never commit real secrets.

APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Supabase Postgres (use the pooled connection string; PgBouncer transaction mode)
DATABASE_URL=

# Upstash Redis
REDIS_URL=

# Min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=

# MSG91 (OTP)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Cloudinary (signed uploads — secret stays server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstrap admin, seeded on every boot (the hash is re-upserted from these).
# NEVER reuse a local password in staging/production — these grant full admin.
ADMIN_USER=
ADMIN_PASS=

# true  = OTP is logged + returned in the API response (NO SMS sent). Local/staging only.
# false = OTP is sent via MSG91; the keys above must be set or login returns 503.
OTP_DEV_MODE=true
